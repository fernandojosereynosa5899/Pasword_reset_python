# ====================================================================
# .gitignore para proyecto FastAPI - Password Reset
# ====================================================================

# --- Entornos virtuales de Python ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Caché y compilados de Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Base de datos local (SQLite / SQLAlchemy) ---
*.db
*.sqlite
*.sqlite3
app.db

# --- Variables de entorno y credenciales sensibles ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# --- Logs y archivos temporales ---
*.log
logs/
*.tmp
*.temp

# --- Pruebas y cobertura de código (Testing & Coverage) ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# --- Configuración de Editores e IDEs ---
# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# PyCharm / JetBrains
.idea/

# Sublime Text / Atom
*.sublime-workspace
*.sublime-project

# --- Archivos del Sistema Operativo ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
